# Convex deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=dev:your-deployment

# Frontend → Convex
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# SPA origin (must match Convex SITE_URL / trustedOrigins)
VITE_SITE_URL=http://localhost:5173

# --- Set on the Convex deployment (npx convex env set ...) ---
# SITE_URL=http://localhost:5173
# BETTER_AUTH_SECRET=<openssl rand -base64 32>
# GOOGLE_CLIENT_ID=<from Google Cloud Console>
# GOOGLE_CLIENT_SECRET=<from Google Cloud Console>
# FIRECRAWL_API_KEY=...
# AGENTMAIL_API_KEY=...

# Google OAuth authorized redirect URI (SPA / Convex Better Auth):
#   https://your-deployment.convex.site/api/auth/callback/google
# Authorized JavaScript origins:
#   http://localhost:5173
#   https://your-production-spa-origin
